{
	"manifest_version": 3,
	"name": "Study Buddy — Visual Edit (dev)",
	"version": "0.1.0",
	"description": "Phase 2: circle part of a page you're running locally and see exactly which source location it maps to. No voice or editing yet.",
	"permissions": ["activeTab", "scripting"],
	"host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["http://localhost/*", "http://127.0.0.1/*"],
			"js": ["content-script.js"],
			"run_at": "document_idle"
		}
	],
	"commands": {
		"toggle-overlay": {
			"suggested_key": {
				"default": "Ctrl+Shift+E",
				"mac": "Command+Shift+E"
			},
			"description": "Toggle the circle-select overlay"
		}
	}
}
