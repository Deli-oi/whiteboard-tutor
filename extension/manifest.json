{
	"manifest_version": 3,
	"name": "Study Buddy — Visual Edit",
	"version": "0.4.0",
	"description": "Circle anything on any webpage, speak, and get a real computed visualization - generated with your own API key, no shared backend.",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"permissions": ["activeTab", "storage"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content-script.js"],
			"run_at": "document_idle"
		}
	],
	"commands": {
		"toggle-overlay": {
			"suggested_key": {
				"default": "Ctrl+Shift+E",
				"mac": "Command+Shift+E"
			},
			"description": "Toggle the circle-select overlay"
		}
	},
	"options_page": "options.html",
	"sandbox": {
		"pages": ["render.html"]
	},
	"web_accessible_resources": [
		{
			"resources": ["render.html", "render.js", "vendor/*"],
			"matches": ["<all_urls>"]
		}
	]
}
