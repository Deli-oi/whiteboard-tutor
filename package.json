		"@worker-tools/json-stream": "^0.1.0-pre.12",
		"ai": "^5.0.194",
		"best-effort-json-parser": "^1.1.3",
		"itty-router": "^5.0.18",
		"katex": "^0.19.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-markdown": "^10.1.0",
		"tldraw": "^5.4.2",
